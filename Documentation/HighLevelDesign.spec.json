    },
    {
      "id": "install-channel",
      "header": "userInstallChannel",
      "body": "Vendor download / internal portal /\nIT-mediated install. Platform is\nagnostic about which channel.",
      "kind": "external", "size": [320, 170]
    },
    {
      "id": "appinsights",
      "header": "appInsights",
      "body": "Client-side telemetry,\nunhandled-error logging.",
      "kind": "external", "size": [320, 140]
    },
    {
      "id": "ppadmin",
      "header": "powerPlatformAdminCentre",
      "body": "Flow run history, connector\nhealth, DLP enforcement.",
      "kind": "external", "size": [320, 150]
    }
  ],

  "edges": [
    { "from": "actor-req",   "to": "codeapp-grp" },
    { "from": "actor-app",   "to": "codeapp-grp" },

    { "from": "codeapp-grp", "to": "entraId",         "label": "SSO" },
    { "from": "codeapp-grp", "to": "microsoftGraph",  "label": "Graph token\n/me/memberOf" },
    { "from": "microsoftGraph", "to": "securityGroup","label": "resolves role", "style": "dashed" },

    { "from": "codeapp-grp", "to": "dataverse", "label": "read / write\nSDK-generated services", "style": "bidirectional" },

    { "from": "dataverse", "to": "pa-grp",     "label": "row trigger" },
    { "from": "pa-grp",    "to": "exchangeTeams", "label": "email + Teams" },

    { "from": "exchangeTeams", "to": "actor-req", "label": "approval +\nlicenseGrant", "style": "dashed",
      "exit": [1.0, 0.5], "entry": [0.5, 0.0],
      "waypoints": [[1820, 880], [1820, 115], [200, 115]] },

    { "from": "decision-approve", "to": "term-approved", "branchLabel": "Approve" },
    { "from": "decision-approve", "to": "term-moreinfo", "branchLabel": "More info" },
    { "from": "decision-approve", "to": "term-rejected", "branchLabel": "Reject" },

    { "from": "term-moreinfo", "to": "messageThread", "label": "reopens thread", "style": "dashed",
      "exit": [0.0, 0.5], "entry": [0.0, 0.5] },

    { "from": "markInstalled", "to": "term-installed",     "branchLabel": "installed" },
    { "from": "markInstalled", "to": "term-installfailed", "branchLabel": "failed" },

    { "from": "ado-push",     "to": "codeapp-grp", "label": "pac code push\n(deploys Code App)" },

    { "from": "codeapp-grp",  "to": "eproc",           "label": "evidence URLs\n(reference only)", "style": "dashed" },
    { "from": "actor-req",    "to": "install-channel", "label": "self-installs with\ngranted licence\n(out of band)", "style": "dashed" }
  ],

  "legend": { "auto": true }
