{
  "title": "Software Request & Approval Platform — High-Level Architecture",
  "subtitle": "Draft v0.3 — for client review",
  "page": { "width": 1840, "height": 1400 },

  "actors": [
    { "id": "actor-req",   "label": "Requester\n(Employee)" },
    { "id": "actor-app",   "label": "Approver\n(License / Security Reviewer)" },
    { "id": "actor-admin", "label": "Platform Admin /\nDevOps Engineer" }
  ],

  "phases": {
    "main": [
      {
        "id": "phase-identity",
        "label": "IDENTITY & ACCESS",
        "rows": [
          ["entraId", "microsoftGraph", "securityGroup"]
        ]
      },
      {
        "id": "phase-runtime",
        "label": "POWER PLATFORM RUNTIME",
        "rows": [
          [
            "codeapp-grp",
            "dataverse",
            { "stack": ["pa-grp", "exchangeTeams"] }
          ]
        ]
      },
      {
        "id": "phase-outcomes",
        "label": "REQUEST OUTCOMES — decision branches + lifecycle terminals",
        "rows": [
          [
            "decision-approve",
            { "stack": ["term-approved", "term-moreinfo", "term-rejected"] },
            { "stack": ["term-installed", "term-installfailed"] }
          ]
        ]
      },
      {
        "id": "phase-cicd",
        "label": "PLATFORM CI/CD — Azure DevOps (Code App build & release only)",
        "rows": [
          ["ado-checkout", "ado-test", "ado-sbom", "ado-vuln", "ado-build", "ado-push"]
        ]
      }
    ],
    "right": [
      {
        "id": "phase-external",
        "label": "EXTERNAL / OUT-OF-BAND",
        "rows": [
          ["eproc"],
          ["install-channel"],
          ["appinsights"],
          ["ppadmin"]
        ]
      }
    ]
  },

  "groups": [
    {
      "id": "codeapp-grp",
      "label": "codeAppComponents — React 19 + TypeScript + Vite + @microsoft/power-apps SDK",
      "rows": [
        ["requesterForm",  "myRequests"],
        ["approverQueue",  "approverDecisionPanel"],
        ["messageThread",  "auditView"],
        ["markInstalled"]
      ]
    },
    {
      "id": "pa-grp",
      "label": "powerAutomateFlows",
      "rows": [
        ["pa-approval"],
        ["pa-fanout"],
        ["pa-grant"],
        ["pa-moreinfo"]
      ]
    }
  ],

  "nodes": [
    { "id": "entraId",         "header": "entraId",         "body": "Tenant SSO",                              "kind": "function-call", "size": [320, 110] },
