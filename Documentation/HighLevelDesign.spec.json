    { "id": "ado-sbom",     "header": "sbomSyft",   "body": "node_modules SBOM",                      "kind": "function-call", "size": [220, 110] },
    { "id": "ado-vuln",     "header": "vulnGrype",  "body": "gate on severity",                       "kind": "function-call", "size": [220, 110] },
    { "id": "ado-build",    "label": "viteBuild",                                                      "kind": "function-call", "size": [220, 90] },
    { "id": "ado-push",     "header": "pacCodePush","body": "→ Dev / Test / Prod",                    "kind": "function-call", "size": [240, 110] },

    {
      "id": "eproc",
